{
  "camera": {
    "params": {
      "distance": 5,
      "fov": 80,
      "height": 0.5,
      "orbitSpeed": 0.3,
      "rollSpeed": 0.05
    },
    "type": "orbit"
  },
  "effects": [
    {
      "effect": "feedback",
      "id": "feedback",
      "params": {
        "amount": 0.9,
        "rotate": 0.01,
        "zoom": 1.03
      }
    },
    {
      "effect": "warp",
      "id": "warp",
      "params": {
        "amount": 0.01,
        "scale": 2
      }
    },
    {
      "effect": "mirror",
      "id": "mirror",
      "params": {
        "horizontal": 1
      }
    },
    {
      "effect": "chroma",
      "id": "chroma",
      "params": {
        "amount": 0.006
      }
    },
    {
      "effect": "film",
      "id": "film",
      "params": {
        "contrast": 1.2,
        "grain": 0.1
      }
    }
  ],
  "generator": {
    "detail": 2,
    "params": {
      "bands": 8,
      "explode": 0.3,
      "light": 1.6,
      "noiseAmount": 0.15,
      "scale": 1.5,
      "spectrum": 0.5,
      "spectrumMode": 2,
      "spin": 0.3,
      "tumble": 0.2,
      "wire": 0.4
    },
    "preset": "shard-field",
    "shape": "shards",
    "type": "lowpoly"
  },
  "inputs": [
    {
      "type": "audio"
    },
    {
      "type": "clock"
    }
  ],
  "mappings": [
    {
      "amount": 0.4,
      "curve": 1.5,
      "source": "audio.kick",
      "target": "generator.explode"
    },
    {
      "amount": 0.12,
      "smooth": 0.1,
      "source": "audio.mid",
      "target": "post.warp.amount"
    },
    {
      "amount": 0.1,
      "source": "mod.lfo.out",
      "target": "post.feedback.rotate"
    },
    {
      "amount": 0.08,
      "smooth": 0.04,
      "source": "audio.kick",
      "target": "camera.fov"
    },

    {
      "source": "palette.colors",
      "target": "generator.pal"
    },
    {
      "source": "audio.spectrum",
      "target": "generator.spec"
    }
  ],
  "modulators": [
    {
      "id": "lfo",
      "params": {
        "rate": 7,
        "shape": 2,
        "sync": 1
      },
      "type": "lfo"
    }
  ],
  "name": "Shard Field",
  "palette": {
    "colors": [
      "#050505",
      "#1A1A2E",
      "#E94560",
      "#F5F5F5"
    ],
    "preset": "noir"
  }
}
